# aud.io Server Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Cache
CACHE_TTL=300

# SoundCloud (optional - for SoundCloud search)
SOUNDCLOUD_CLIENT_ID=

# Podcast Index API (required for podcast features)
# Get your FREE API key at: https://podcastindex.org/
# No rate limits for search, generous limits for other endpoints
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT=aud.io/1.0
